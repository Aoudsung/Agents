{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAI full-text evidence card v2",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "classification",
    "reading",
    "argument",
    "findings",
    "claims",
    "relations",
    "brief_questions",
    "feedback",
    "optional_gap",
    "optional_opportunity",
    "cautions"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^P[0-9]+$"},
    "title": {"type": "string", "minLength": 10},
    "classification": {
      "type": "object",
      "required": [
        "paper_type",
        "study_design",
        "evidence_mode",
        "analysis_unit",
        "inference_scope",
        "classification_evidence"
      ],
      "properties": {
        "paper_type": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        },
        "study_design": {"type": "string", "minLength": 10},
        "evidence_mode": {"type": "string", "minLength": 10},
        "analysis_unit": {"type": "string", "minLength": 5},
        "inference_scope": {"type": "string", "minLength": 10},
        "classification_evidence": {"type": "string", "pattern": "TXT:[0-9]"}
      },
      "additionalProperties": false
    },
    "reading": {
      "type": "object",
      "required": [
        "reading_role",
        "why_read",
        "audience",
        "priority",
        "priority_reason",
        "best_sections",
        "use_for",
        "do_not_use_for"
      ],
      "properties": {
        "reading_role": {"type": "string", "minLength": 2},
        "why_read": {"type": "string", "minLength": 30},
        "audience": {"type": "string", "minLength": 5},
        "priority": {"enum": ["高", "中", "低"]},
        "priority_reason": {"type": "string", "minLength": 15},
        "best_sections": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        },
        "use_for": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 10}
        },
        "do_not_use_for": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 10}
        }
      },
      "additionalProperties": false
    },
    "argument": {
      "type": "object",
      "required": ["problem", "questions", "steps", "contributions", "not_claimed"],
      "properties": {
        "problem": {"type": "string", "minLength": 30},
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 10}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "question",
              "method_or_material",
              "direct_output",
              "location"
            ],
            "properties": {
              "label": {"type": "string", "minLength": 2},
              "question": {"type": "string", "minLength": 5},
              "method_or_material": {"type": "string", "minLength": 10},
              "direct_output": {"type": "string", "minLength": 10},
              "location": {"type": "string", "pattern": "TXT:[0-9]"}
            },
            "additionalProperties": false
          }
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 10}
        },
        "not_claimed": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 10}
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "finding",
          "evidence_type",
          "setting_or_sample",
          "location",
          "author_interpretation",
          "boundary_or_counterevidence"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]+$"},
          "finding": {"type": "string", "minLength": 20},
          "evidence_type": {"type": "string", "minLength": 5},
          "setting_or_sample": {"type": "string", "minLength": 5},
          "location": {"type": "string", "pattern": "TXT:[0-9]"},
          "author_interpretation": {"type": "string", "minLength": 10},
          "boundary_or_counterevidence": {"type": "string", "minLength": 10}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim_text",
          "statement_source",
          "claim_kind",
          "analysis_unit",
          "evidence_type",
          "evidence_location",
          "observed_result",
          "inference_rule",
          "required_assumptions",
          "support_status",
          "boundary_conditions",
          "unresolved_part"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]+$"},
          "claim_text": {"type": "string", "minLength": 20},
          "statement_source": {
            "enum": ["author statement", "author interpretation", "analyst inference"]
          },
          "claim_kind": {
            "enum": [
              "descriptive",
              "associational",
              "causal",
              "mechanism",
              "design",
              "measurement",
              "theoretical",
              "normative",
              "extrapolative"
            ]
          },
          "analysis_unit": {"type": "string", "minLength": 5},
          "evidence_type": {"type": "string", "minLength": 5},
          "evidence_location": {"type": "string", "pattern": "TXT:[0-9]"},
          "observed_result": {"type": "string", "minLength": 20},
          "inference_rule": {"type": "string", "minLength": 15},
          "required_assumptions": {"type": "string", "minLength": 10},
          "support_status": {
            "enum": ["direct", "conditional", "indirect", "undetermined", "contradicted"]
          },
          "boundary_conditions": {"type": "string", "minLength": 10},
          "unresolved_part": {"type": "string", "minLength": 5}
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "relation_kind", "relation", "conditions", "evidence_level"],
        "properties": {
          "target": {"type": "string", "minLength": 2},
          "relation_kind": {
            "enum": [
              "direct",
              "extends",
              "conditions",
              "challenges",
              "measurement",
              "governance",
              "analogue",
              "incomparable"
            ]
          },
          "relation": {"type": "string", "minLength": 15},
          "conditions": {"type": "string", "minLength": 10},
          "evidence_level": {"enum": ["metadata", "abstract", "full text"]}
        },
        "additionalProperties": false
      }
    },
    "brief_questions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "target_judgment",
          "current_search_judgment",
          "why_it_matters",
          "expected_evidence",
          "priority",
          "status",
          "conclusion",
          "evidence_location",
          "evidence_type",
          "remaining_uncertainty",
          "judgment_change",
          "reading_value_change",
          "domain_relation_change",
          "next_search_action"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^Q[0-9]+$"},
          "question": {"type": "string", "minLength": 10},
          "target_judgment": {"type": "string", "minLength": 10},
          "current_search_judgment": {"type": "string", "minLength": 10},
          "why_it_matters": {"type": "string", "minLength": 10},
          "expected_evidence": {"type": "string", "minLength": 5},
          "priority": {"enum": ["high", "medium", "low"]},
          "status": {
            "enum": ["answered", "partial", "undetermined", "not-applicable"]
          },
          "conclusion": {"type": "string", "minLength": 10},
          "evidence_location": {"type": "string", "pattern": "TXT:[0-9]"},
          "evidence_type": {"type": "string", "minLength": 5},
          "remaining_uncertainty": {"type": "string", "minLength": 5},
          "judgment_change": {"type": "string", "minLength": 5},
          "reading_value_change": {"type": "string", "minLength": 5},
          "domain_relation_change": {"type": "string", "minLength": 5},
          "next_search_action": {"type": "string", "minLength": 2}
        },
        "additionalProperties": false
      }
    },
    "feedback": {
      "type": "object",
      "required": [
        "reading_value_before",
        "reading_value_after",
        "domain_relation_before",
        "domain_relation_after",
        "relation_kind",
        "new_terms",
        "citations_to_expand",
        "invalidated_routes_or_tasks"
      ],
      "properties": {
        "reading_value_before": {"type": "string", "minLength": 10},
        "reading_value_after": {"type": "string", "minLength": 20},
        "domain_relation_before": {"type": "string", "minLength": 10},
        "domain_relation_after": {"type": "string", "minLength": 20},
        "relation_kind": {"type": "string", "minLength": 2},
        "new_terms": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "citations_to_expand": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "invalidated_routes_or_tasks": {"type": "array", "items": {"type": "string", "minLength": 2}}
      },
      "additionalProperties": false
    },
    "optional_gap": {"type": ["object", "null"]},
    "optional_opportunity": {"type": ["object", "null"]},
    "cautions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 10}
    }
  },
  "additionalProperties": false
}
